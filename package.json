{
  "name": "plesfeda",
  "private": true,
  "version": "1.0.0",
  "description": "Plesfeda — a board for building real Work Breakdown Structures. Breakdown first, schedule later.",
  "type": "module",
  "workspaces": [
    "kimetron/packages/*",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w plesfeda-app",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuculhart/plesfeda.git"
  },
  "homepage": "https://cuculhart.github.io/plesfeda/"
}